# Salin menjadi deploy/vps/.env lewat ./init-env.sh (mode 600). Hanya nama variabel di repo; nilai hanya di VPS.
# Dibuat otomatis oleh init-env.sh bila kosong: MYSQL_ROOT_PASSWORD, DB_APP_PASSWORD, JWT_SECRET, CRON_SECRET,
# BACKUP_CIPHER_PASS. Simpan BACKUP_CIPHER_PASS juga di pengelola sandi pemilik: tanpa itu cadangan tidak bisa dibuka.

# Nama tumpukan (satu per perusahaan) dan versi image (hash git yang dibangun)
COMPOSE_PROJECT_NAME=moneychanger
APP_VERSION=

# Jaringan Caddy ↔ aplikasi (dibuat sekali: docker network create --subnet 172.30.0.0/24 --ip-range 172.30.0.0/25 mc_edge) dan alamat tetap
# Caddy tokoemas di jaringan itu (satu-satunya pengirim X-Forwarded-For yang dipercaya). Gladi lokal: compose.local.yaml.
EDGE_NETWORK=mc_edge
EDGE_PROXY_IP=172.30.0.254

# MySQL
MYSQL_ROOT_PASSWORD=
DB_APP_PASSWORD=
MYSQL_BUFFER_POOL=1G
MYSQL_MEM_LIMIT=2g

# Alamat: publik untuk nasabah, back office untuk staf (kosong = tanpa pemisahan)
PUBLIC_HOST=ibukotavalasindo.online
BACKOFFICE_HOST=backoffice.ibukotavalasindo.online

# Aplikasi
JWT_SECRET=
CRON_SECRET=

# Dokumen KYC/operasional di Cloudflare R2 (token khusus bucket dokumen)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cadangan: kata sandi enkripsi, jumlah salinan lokal, dan tujuan R2 (kosong = hanya lokal).
# BACKUP_REMOTE berbentuk r2:<bucket-cadangan>/<folder>, mis. r2:ibv-cadangan/mysql (token bucket TERPISAH dari dokumen).
BACKUP_CIPHER_PASS=
BACKUP_KEEP_LOCAL=7
BACKUP_REMOTE=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
