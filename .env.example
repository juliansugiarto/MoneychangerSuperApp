# =============================================================================
# MoneychangerSuperApp — konfigurasi environment untuk self-hosted deployment
# Salin file ini ke ".env" lalu isi semua nilai. JANGAN commit ".env" ke git.
# =============================================================================

NODE_ENV=production
PORT=3000

# --- Database (MySQL 8+ atau TiDB) ------------------------------------------
# Format: mysql://user:password@host:port/nama_database
DATABASE_URL=mysql://appuser:CHANGE_ME@127.0.0.1:3306/moneychanger

# --- Autentikasi internal ----------------------------------------------------
# JWT_SECRET: string acak panjang, generate dengan: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_HEX

# Akun Shareholder awal yang dibuat otomatis saat server pertama kali start
INITIAL_SHAREHOLDER_USERNAME=CHANGE_ME
INITIAL_SHAREHOLDER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Cloudflare R2 (penyimpanan dokumen KYC & lampiran) ----------------------
# Ambil dari Cloudflare dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=ibukotavalasindo-documents

# --- Cron sinkronisasi kurs BI -----------------------------------------------
# String acak untuk otentikasi endpoint /api/scheduled/bi-rate-sync.
# Generate dengan: openssl rand -hex 32
# Dipakai di header: x-cron-secret: <nilai ini>
CRON_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_HEX

# --- Opsional / legacy (aman dikosongkan untuk deployment mandiri) ----------
VITE_APP_ID=
OWNER_OPEN_ID=
